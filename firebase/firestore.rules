rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Home slider cards: everyone can read, only listed admins can write.
    match /feed/{card} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['you@example.com'];
    }
  }
}
